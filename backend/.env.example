# Copy this file to .env and fill in real values.
# See guides/ for who is responsible for which service credentials.



# database (mongoDb)

MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=


# Server
PORT=
NODE_ENV=
DATABASE_URL=
CORS_ORIGINS=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Initial administrator (used only by npm run seed:admin)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Redis (caching + rate limiting)
REDIS_URL=

# Email (transactional - welcome, password reset, order updates)
EMAIL_FROM=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# Frontend URL
CLIENT_URL=


# Paystack (use your SECRET key here, starts with sk_, not pk_)
PAYSTACK_SECRET_KEY=

# Set to "true" only in local/dev to allow makePayment to accept
# transaction_ref values starting with "test_" without hitting Paystack.
# Must never be set in production.
ALLOW_TEST_PAYMENTS=false