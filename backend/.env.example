# Copy this file to .env and fill in real values.
# See guides/ for who is responsible for which service credentials.

# Server
PORT=
NODE_ENV=
DATABASE_URL=
CORS_ORIGINS=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Redis (caching + rate limiting)
REDIS_URL=

# Email (transactional - welcome, password reset, order updates)
EMAIL_FROM=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# Frontend URL
CLIENT_URL=


