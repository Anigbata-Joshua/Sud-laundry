# Copy this file to .env and fill in real values.
# See guides/ for who is responsible for which service credentials.

# Server
PORT=
NODE_ENV=
CORS_ORIGINS=
LOG_LEVEL=

# Database (MongoDB)
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Initial administrator (used only by npm run seed:admin)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Redis (caching + rate limiting)
REDIS_URL=

# Frontend URL (used in password-reset and email links)
FRONTEND_URI=
CLIENT_URL=

# Orders
CANCELLATION_WINDOW_MINUTES=30
EXPRESS_SURCHARGE_PERCENT=30

# Admin digest notifications (cron string; default weekly, Monday 08:00)
ADMIN_DIGEST_SCHEDULE="0 8 * * 1"

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_DOMAIN=resend.dev
# Set to "true" in local/dev to log emails instead of sending them
USE_MOCK_EMAIL=true

# Paystack (use your SECRET key here, starts with sk_, not pk_)
PAYSTACK_SECRET_KEY=

# Set to "true" only in local/dev to allow makePayment to accept
# transaction_ref values starting with "test_" without hitting Paystack.
# Must never be set in production.
ALLOW_TEST_PAYMENTS=false